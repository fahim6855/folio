# Copy to .env.local (local) and add the same two values in Vercel → Settings → Environment Variables.
# Supabase → Project Settings → API. Use the public "publishable" (or legacy "anon") key. NEVER the secret / service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
